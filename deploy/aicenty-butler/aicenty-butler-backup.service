[Unit]
Description=Aicenty Butler transaction-safe local backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/aicenty-butler/current/scripts/backup-db.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/backups /var/lib/docker /run/docker.sock
